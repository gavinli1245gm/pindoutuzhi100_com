---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { getFirstImage } from '@/utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tagSet = new Set<string>();
  posts.forEach((post) => {
    (post.data.tags || []).forEach((tag: string) => tagSet.add(tag));
  });
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allPosts = await getCollection('posts');
type BlogPost = (typeof allPosts)[number];
const posts = allPosts
  .filter((p: BlogPost) => (p.data.tags || []).includes(tag))
  .sort((a: BlogPost, b: BlogPost) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const postsPerPage = siteConfig.list.postsPerPage;
const currentPage = 1;
const totalPages = Math.max(1, Math.ceil(posts.length / postsPerPage));
const pagedPosts = posts.slice(0, postsPerPage);

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: `# ${tag}` },
];
---

<BaseLayout
  title={`${tag} - ${siteConfig.list.title} | ${siteConfig.site.name}`}
  description={`关于「${tag}」的所有内容`}
>
  <Breadcrumb items={breadcrumbs} />

  <section class="py-6 md:py-10 cute-dots">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="inline-block bg-pink-100/80 dark:bg-purple-900/40 text-primary-dark text-sm font-medium px-4 py-2 rounded-full mb-4">
          ✿ 标签
        </span>
        <h1 class="text-3xl md:text-4xl font-bold text-gray-800 dark:text-gray-100 mb-3" style="font-family: var(--font-display)">
          # {tag}
        </h1>
        <p class="text-gray-600 dark:text-gray-300">共 {posts.length} 篇文章</p>
      </div>

      {pagedPosts.length === 0 ? (
        <p class="text-center text-gray-400 py-12">暂无文章</p>
      ) : (
        <div>
          <div class="columns-2 lg:columns-3 gap-4 md:gap-6 [column-fill:balance]">
            {pagedPosts.map((post: BlogPost) => {
              const cover = getFirstImage(post.body) || post.data.image;
              return (
                <a
                  href={`/${post.id}`}
                  class="cute-card group mb-4 md:mb-6 break-inside-avoid block bg-white/90 dark:bg-gray-800/90 border-2 border-pink-200/50 dark:border-purple-300/30 rounded-3xl overflow-hidden hover:border-pink-300/70 dark:hover:border-purple-400/50 transition-all"
                >
                  {cover && (
                    <img
                      src={cover}
                      alt={post.data.title}
                      class="w-full object-cover"
                      loading="lazy"
                    />
                  )}
                  <div class="p-5">
                    <h2 class="text-base font-semibold text-gray-800 dark:text-gray-100 group-hover:text-primary-dark transition-colors line-clamp-2" style="font-family: var(--font-display)">
                      {post.data.title}
                    </h2>
                    <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 line-clamp-3">{post.data.description}</p>
                  </div>
                </a>
              );
            })}
          </div>

          {totalPages > 1 && (
            <nav class="pt-2 flex items-center justify-center gap-2" aria-label="标签分页">
              <span class="px-4 py-2 text-sm rounded-full border-2 border-pink-200/50 dark:border-purple-300/30 text-gray-400 dark:text-gray-500">
                上一页
              </span>
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
                <a
                  href={page === 1 ? `/tag/${encodeURIComponent(tag)}` : `/tag/${encodeURIComponent(tag)}/page/${page}`}
                  class:list={[
                    'px-4 py-2 text-sm rounded-full border-2 transition-all hover:scale-105',
                    page === currentPage
                      ? 'border-pink-400 dark:border-purple-400 bg-pink-100/80 dark:bg-purple-900/50 text-primary-dark font-medium'
                      : 'border-pink-200/50 dark:border-purple-300/30 text-gray-600 dark:text-gray-300 hover:border-pink-300/70 dark:hover:border-purple-400/50 hover:text-primary-dark',
                  ]}
                  aria-current={page === currentPage ? 'page' : undefined}
                >
                  {page}
                </a>
              ))}
              <a
                href={`/tag/${encodeURIComponent(tag)}/page/${currentPage + 1}`}
                class="px-4 py-2 text-sm rounded-full border-2 border-pink-200/50 dark:border-purple-300/30 text-gray-600 dark:text-gray-300 hover:border-pink-300/70 dark:hover:border-purple-400/50 hover:text-primary-dark transition-all hover:scale-105"
              >
                下一页
              </a>
            </nav>
          )}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
